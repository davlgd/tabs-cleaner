{
  "manifest_version": 3,
  "name": "Tabs Cleaner",
  "version": "0.1.0",
  "description": "Quick stats and cleanup for your open browser tabs.",
  "author": "davlgd",
  "homepage_url": "https://github.com/davlgd/tabs-cleaner",
  "permissions": ["tabs"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tabs Cleaner",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
